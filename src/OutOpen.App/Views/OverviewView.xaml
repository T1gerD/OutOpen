<UserControl x:Class="OutOpen.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource Card}" Padding="24">
                <StackPanel>
                    <TextBlock Text="接管状态" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding StatusHeadline}" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,18,0,0">
                        <Button Content="{Binding PauseButtonText}" Command="{Binding TogglePauseCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" />
                        <Button Content="手动打开文件…" Command="{Binding OpenFileCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" />
                        <Button Content="打开日志" Command="{Binding OpenLogsCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                        <Button Content="数据目录" Command="{Binding OpenDataFolderCommand}"
                                Style="{StaticResource SecondaryButton}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="来源应用" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding SourceSummary}" FontSize="14" Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Text="只处理文件落盘后的新文件；微信/QQ 等应用内部的点击行为不会被改写。"
                                   Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="事件统计" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding EventSummary}" FontSize="14" Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Text="所有处理都可以在事件日志里追溯；失败不会阻断原应用。"
                                   Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="22" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="最近事件" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="还没有打开记录。收到新文件，或点上面的「手动打开文件…」试试。"
                               Margin="0,10,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Recent.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Recent}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding TimeText}" Style="{StaticResource Muted}" />
                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                                   FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Grid.Column="2" Text="{Binding FileName}" Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding TypeText}" Style="{StaticResource Muted}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
