<UserControl x:Class="OutOpen.App.Views.ViewersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource Card}" Padding="22">
                <StackPanel>
                    <TextBlock Text="查看器推荐" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="OutOpen 只检测当前关联是否可用，不会自动安装软件，也不会修改你的默认关联。推荐项均来自官方入口，并记录了核验时间。"
                               Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <ComboBox ItemsSource="{Binding Extensions}" SelectedItem="{Binding SelectedExtension}"
                                  DisplayMemberPath="Label" Width="220" VerticalAlignment="Center" />
                        <Button Content="重新检测" Command="{Binding RecheckCommand}" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" />
                        <Button Content="稍后提醒" Command="{Binding SnoozeCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                        <Button Content="不再提醒" Command="{Binding IgnoreCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                        <Button Content="恢复推荐" Command="{Binding ResetCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding Notice}" Foreground="{StaticResource SuccessBrush}" Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="22" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding StatusText}" FontSize="17" FontWeight="SemiBold" Foreground="{Binding StatusBrush}" />
                    <TextBlock Text="{Binding DetailText}" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StateText}" FontSize="12" Foreground="#475569" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Recommendations}" Margin="0,14,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="{Binding Purpose}" Style="{StaticResource Muted}" Margin="0,4,12,0" TextWrapping="Wrap" />
                                    <TextBlock FontSize="11" Foreground="#64748B" Margin="0,8,0,0" TextWrapping="Wrap">
                                        <Run Text="核验时间 " /><Run Text="{Binding VerifiedAt}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Content="{Binding LinkText}" Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding OfficialUrl}" Style="{StaticResource SecondaryButton}" />
                                    <Button Content="官方下载页" Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding DownloadUrl}" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
