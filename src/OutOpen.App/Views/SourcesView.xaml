<UserControl x:Class="OutOpen.App.Views.SourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource Card}" Padding="22">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="来源应用接管" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="勾选允许 OutOpen 监听的应用。OutOpen 只监听这些应用保存文件的目录，文件完整落盘后才外部打开；应用内部的点击预览行为不会被劫持。"
                                       Style="{StaticResource Muted}" Margin="0,6,20,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding Notice}" Foreground="{StaticResource SuccessBrush}" Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Rows}" Margin="0,14,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Top" Margin="0,2,14,0" />
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                        <Border Background="#EEF2FF" CornerRadius="10" Padding="9,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Priority}" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="12"
                                                   FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding FoldersText}" FontSize="11" Foreground="#475569" Margin="0,8,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
