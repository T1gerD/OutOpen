<UserControl x:Class="OutOpen.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource Card}" Padding="22">
                <StackPanel>
                    <TextBlock Text="启动与后台" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="开机自启默认关闭，只有你在这里勾选并保存后才会写入当前用户的启动项；卸载或退出不会改动任何文件关联。"
                               Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <CheckBox Content="开机时自动启动（登录后最小化到托盘）" IsChecked="{Binding StartWithWindows}" Margin="0,16,0,0" />
                    <CheckBox Content="关闭窗口时最小化到系统托盘，而不是退出" IsChecked="{Binding MinimizeToTray}" Margin="0,10,0,0" />
                    <CheckBox Content="显示通知气泡" IsChecked="{Binding ShowNotifications}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="22" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="接管与校验" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <CheckBox Content="新文件到达后自动用外部程序打开" IsChecked="{Binding AutoOpenOnArrival}" Margin="0,16,0,0" />
                    <CheckBox Content="要求文件签名与扩展名一致（更严格，可能跳过部分文件）" IsChecked="{Binding RequireSignatureMatch}" Margin="0,10,0,0" />
                    <CheckBox Content="启动时扫描最近 10 分钟已到达的文件" IsChecked="{Binding ScanExistingFilesOnStart}" Margin="0,10,0,0" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="文件稳定等待（秒）" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                        <TextBox Grid.Column="1" Text="{Binding StabilitySeconds, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center" Padding="8,4" />
                        <TextBlock Grid.Column="2" Text="文件大小连续这么久没变化才视为下载完成" Style="{StaticResource Muted}" Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="重复事件窗口（秒）" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                        <TextBox Grid.Column="1" Text="{Binding DedupeWindowSeconds, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center" Padding="8,4" />
                        <TextBlock Grid.Column="2" Text="同一文件在这段时间内的重复事件只处理一次" Style="{StaticResource Muted}" Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="最大打开文件（MB）" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                        <TextBox Grid.Column="1" Text="{Binding MaxFileSizeMb, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center" Padding="8,4" />
                        <TextBlock Grid.Column="2" Text="超过大小的文件记录后跳过，避免误开超大文件" Style="{StaticResource Muted}" Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="日志保留（天）" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                        <TextBox Grid.Column="1" Text="{Binding LogRetentionDays, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center" Padding="8,4" />
                        <TextBlock Grid.Column="2" Text="超期日志在下次启动时清理" Style="{StaticResource Muted}" Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="22" Margin="0,14,0,0">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="恢复已保存值" Command="{Binding ReloadCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                            <Button Content="保存设置" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="保存与目录" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="配置保存在 %LOCALAPPDATA%\OutOpen 下，可随时手动备份或删除恢复默认。"
                                       Style="{StaticResource Muted}" Margin="0,6,20,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="打开数据目录" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                        <Button Content="打开日志目录" Command="{Binding OpenLogsCommand}" Style="{StaticResource SecondaryButton}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Notice}" Foreground="{StaticResource SuccessBrush}" Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
